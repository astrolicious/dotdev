---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
	article: CollectionEntry<'blog'>;
	class?: string;
}

const { article, class: className } = Astro.props;
const { title, publishDate, authors } = article.data;
const { Content } = await render(article);
---

<div class:list={['relative rounded-2xl border border-gray-200 bg-white p-4 shadow-sm', className]}>
	<p class="inline-block text-sm text-gray-600">
		{new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(publishDate)}
		{' '}- {authors.map((author) => author.name).join(', ')}
	</p>
	<h2 class="max-w-2xl font-heading text-2xl font-extrabold text-primary-950 uppercase">
		<a href={`/blog/${article.id}`}>
			{title}
			<span class="absolute inset-0"></span>
		</a>
	</h2>
	<div class="mt-3 line-clamp-3 text-gray-700">
		<Content />
	</div>
</div>

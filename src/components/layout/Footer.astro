---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-t-gray-200">
	<div class="mx-auto max-w-7xl p-2">
		<p>
			&copy; <span id="footer-year">{year}</span> -{' '}
			<a
				href="https://github.com/astrolicious/dotdev/blob/main/LICENSE"
				target="_blank"
				class="underline"
			>
				License
			</a>
		</p>
	</div>
</footer>

<script is:inline>
	document.getElementById('footer-year').textContent = new Date().getFullYear();
</script>

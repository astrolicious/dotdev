---
import type { HTMLTag } from 'astro/types';
import DiscordIcon from '../../icons/discord.svg';
import GitHubIcon from '../../icons/github.svg';
import XIcon from '../../icons/x.svg';
import Logo from './Logo.astro';

interface Props {
	tag?: HTMLTag;
}

const links = [
	{
		href: '/',
		text: 'Home',
	},
	{
		href: '/blog',
		text: 'Articles',
	},
];

const socialLinks = [
	{
		href: 'https://twitter.com/astroliciousdev',
		text: 'Astrolicious on X',
		icon: XIcon,
	},
	{
		href: 'https://github.com/astrolicious',
		text: 'Astrolicious on GitHub',
		icon: GitHubIcon,
	},
	{
		href: 'https://chat.astrolicious.dev',
		text: 'Join Astrolicious on Discord',
		icon: DiscordIcon,
	},
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrentPath = (href: string) => {
	if (href === '/') {
		return pathname === '/';
	}
	return pathname === href || pathname.startsWith(`${href}/`);
};

const Tag = Astro.props.tag ?? 'header';
---

<Tag class="sticky top-0 z-20 border-b border-gray-200 bg-white/95 font-heading backdrop-blur-sm">
	<div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
		<a
			href="/"
			class="inline-flex shrink-0 items-center gap-1.5 rounded-md py-1 text-2xl font-extrabold text-primary-950 uppercase sm:text-3xl"
		>
			<Logo class="size-7 shrink-0 sm:size-8" />
			<span><span class="text-primary-700">Astro</span>licious</span>
		</a>
		<nav aria-label="Primary">
			<ul class="flex items-center gap-1 sm:gap-2">
				{links.map(({ href, text }) => {
					const active = isCurrentPath(href);
					return (
						<li>
							<a
								{href}
								aria-current={active ? 'page' : undefined}
								class:list={[
									'inline-flex min-h-10 items-center rounded-lg px-3 py-1.5 text-base font-extrabold uppercase transition-colors sm:text-lg',
									active
										? 'bg-primary-100 text-primary-950'
										: 'text-primary-950 hover:bg-primary-100',
								]}
							>
								{text}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>
		<div class="flex items-center gap-0.5 sm:gap-1">
			{socialLinks.map(({ href, text, icon: Icon }) => (
				<a
					{href}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex size-10 items-center justify-center rounded-full text-primary-950 transition-colors hover:bg-primary-100"
				>
					<Icon class="size-5" />
					<span class="sr-only">{text}</span>
				</a>
			))}
		</div>
	</div>
</Tag>

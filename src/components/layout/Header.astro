---
import type { HTMLTag } from 'astro/types';
import DiscordIcon from '../../icons/discord.svg';
import GitHubIcon from '../../icons/github.svg';
import XIcon from '../../icons/x.svg';
import Logo from './Logo.astro';

interface Props {
	tag?: HTMLTag;
}

const links = [
	{
		href: '/',
		text: 'Home',
	},
	{
		href: '/blog',
		text: 'Articles',
	},
];

const socialLinks = [
	{
		href: 'https://twitter.com/astroliciousdev',
		text: 'Twitter (X)',
		icon: XIcon,
	},
	{
		href: 'https://github.com/astrolicious',
		text: 'GitHub',
		icon: GitHubIcon,
	},
	{
		href: 'https://chat.astrolicious.dev',
		text: 'Discord',
		icon: DiscordIcon,
	},
];

const Tag = Astro.props.tag ?? 'header';
---

<Tag class="sticky top-0 z-20 border-b border-b-gray-200 bg-white font-heading">
	<div class="relative mx-auto flex h-16 max-w-7xl items-center justify-center p-2">
		<div class="absolute left-2">
			<a
				href="/"
				class="flex items-center gap-1 text-3xl font-extrabold text-primary-950 uppercase"
			>
				<Logo />
				<div><span class="text-primary-600">Astro</span>licious</div>
			</a>
		</div>
		<div class="hidden items-center justify-center lg:flex">
			{links.map(({ href, text }) => (
				<a
					{href}
					class="rounded-md px-3 py-1.5 text-lg font-extrabold text-primary-950 uppercase transition-colors hover:bg-primary-200"
				>
					{text}
				</a>
			))}
		</div>
		<div class="absolute right-2">
			<div class="flex items-center justify-center gap-1">
				{socialLinks.map(({ href, text, icon: Icon }) => (
					<a
						{href}
						target="_blank"
						class="rounded-full p-1 text-lg font-extrabold text-primary-950 uppercase transition-colors hover:bg-primary-200"
					>
						<Icon class="size-6" />
						<span class="sr-only">{text}</span>
					</a>
				))}
			</div>
		</div>
	</div>
	<div class="flex items-center overflow-x-auto border-t border-gray-200 lg:hidden">
		{links.map(({ href, text }) => (
			<a
				{href}
				class="rounded-md px-3 py-1.5 text-lg font-extrabold text-primary-950 uppercase transition-colors hover:bg-primary-200"
			>
				{text}
			</a>
		))}
	</div>
</Tag>

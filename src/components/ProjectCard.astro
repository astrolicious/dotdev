---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import GitHubIcon from '../icons/github.svg';
import GlobeIcon from '../icons/globe.svg';

interface Props {
	project: CollectionEntry<'projects'>;
	class?: string;
}

const { project, class: className } = Astro.props;
const { name, kind, links } = project.data;
const { Content } = await render(project);

const hasLinks = Object.keys(links).length > 0;
---

<div class:list={['rounded-2xl border border-gray-200 bg-white p-4 shadow-sm', className]}>
	<div class="flex items-center justify-between">
		<p
			class="rounded-full bg-primary-300 px-1.5 py-0.5 text-sm leading-5 text-primary-950 capitalize"
		>
			{kind}
		</p>
		{hasLinks && (
			<div class="flex items-center gap-1">
				{links.github && (
					<a
						href={links.github}
						target="_blank"
						class="rounded-full p-1 text-lg font-extrabold text-primary-950 uppercase transition-colors hover:bg-primary-200"
						rel="noopener"
					>
						<GitHubIcon class="size-6" />
						<span class="sr-only">GitHub repository</span>
					</a>
				)}
				{links.website && (
					<a
						href={links.website}
						target="_blank"
						class="rounded-full p-1 text-lg font-extrabold text-primary-950 uppercase transition-colors hover:bg-primary-200"
						rel="noopener"
					>
						<GlobeIcon class="size-6" />
						<span class="sr-only">Website</span>
					</a>
				)}
			</div>
		)}
	</div>
	<h2 class="max-w-2xl font-heading text-2xl font-extrabold text-primary-950 uppercase">{name}</h2>
	<div class="mt-2 text-gray-700">
		<Content />
	</div>
</div>

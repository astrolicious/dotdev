---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import CreativeCommons from '../../components/CreativeCommons.astro';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = (async () => {
	const articles = await getCollection('blog');
	return articles.map((article) => ({
		params: {
			slug: article.id,
		},
		props: {
			article,
		},
	}));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { title, publishDate } = article.data;
const { Content } = await render(article);
---

<Layout {title}>
	<div class="mx-auto max-w-7xl px-2 py-12">
		<div class="prose my-8">
			<p class="lead">
				Published on{' '}
				{new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(publishDate)}
			</p>
			<h1
				class="not-prose font-heading text-5xl font-extrabold text-primary-950 uppercase sm:text-6xl"
			>
				{title}
			</h1>
			<Content />
			<blockquote>
				<CreativeCommons {article} />
			</blockquote>
		</div>
	</div>
</Layout>

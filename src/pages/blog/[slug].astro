---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import CreativeCommons from '../../components/CreativeCommons.astro';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = (async () => {
	const articles = await getCollection('blog');
	return articles.map((article) => ({
		params: {
			slug: article.id,
		},
		props: {
			article,
		},
	}));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { title, description, publishDate, authors } = article.data;
const { Content } = await render(article);
const formattedDate = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(publishDate);
const isoDate = publishDate.toISOString().slice(0, 10);
---

<Layout title={`${title} — Astrolicious`} {description} ogType="article">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
		<article class="mx-auto max-w-3xl">
			<a
				href="/blog"
				class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-700 transition-colors hover:text-primary-900"
			>
				<span aria-hidden="true">&larr;</span>
				Back to articles
			</a>
			<header class="mt-6 border-b border-gray-200 pb-8">
				<p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-600">
					<span> Published on <time datetime={isoDate}>{formattedDate}</time> </span>
					<span aria-hidden="true">&middot;</span>
					<span>
						By{' '}
						{authors.map((author, index) => (
							<>
								{index > 0 && (index === authors.length - 1 ? ' and ' : ', ')}
								<a
									href={author.url}
									target="_blank"
									rel="noopener noreferrer"
									class="font-medium text-gray-800 underline decoration-gray-400 underline-offset-2 transition-colors hover:text-primary-800"
								>
									{author.name}
								</a>
							</>
						))}
					</span>
				</p>
				<h1
					class="mt-3 font-heading text-4xl font-extrabold text-primary-950 uppercase sm:text-5xl"
				>
					{title}
				</h1>
			</header>
			<div
				class="prose prose-lg prose-headings:font-heading prose-headings:font-extrabold prose-headings:text-primary-950 prose-a:text-primary-700 prose-a:underline-offset-2 hover:prose-a:text-primary-900 mt-8 max-w-none"
			>
				<Content />
			</div>
			<footer class="mt-12 border-t border-gray-200 pt-6 text-sm">
				<CreativeCommons {article} />
			</footer>
		</article>
	</div>
</Layout>
